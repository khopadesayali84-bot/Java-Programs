                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        <!-- Product 1 -->
                        <div class="product-card bg-white rounded-lg shadow-sm overflow-hidden transition duration-300">
                            <div class="relative">
                                <img src="http://static.photos/vegetables/640x360/6" alt="Organic Tomatoes" class="w-full h-48 object-cover">
                                <div class="absolute top-2 right-2 bg-green-600 text-white text-xs px-2 py-1 rounded-full">Fresh</div>
                            </div>
                            <div class="p-4">
                                <h3 class="font-semibold text-lg mb-1">Organic Tomatoes</h3>
                                <p class="text-gray-600 text-sm mb-2">From Fresh Farm</p>
