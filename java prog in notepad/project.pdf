                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nearby Farmers -->
                <div>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-gray-800">Farmers Near You</h2>
                        <a href="#" class="text-green-600 hover:underline text-sm">View All</a>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        <!-- Farmer 1 -->
