<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Basket - Farm Fresh Vegetables</title>
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        .hero-bg {
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('http://static.photos/agriculture/1200x630/42');
            background-size: cover;
            background-position: center;
        }
        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body class="font-sans bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-green-700 text-white shadow-lg">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i data-feather="shopping-bag" class="text-green-300"></i>
                <span class="text-xl font-bold">Green Basket</span>
            </div>
            <div class="hidden md:flex space-x-6">
                <a href="#" class="hover:text-green-200">Home</a>
                <a href="#about" class="hover:text-green-200">About</a>
                <a href="#how-it-works" class="hover:text-green-200">How It Works</a>
                <a href="#contact" class="hover:text-green-200">Contact</a>
            </div>
            <div class="flex space-x-4">
                <a href="login.html" class="px-4 py-2 rounded hover:bg-green-600">Login</a>
                <a href="signup.html" class="px-4 py-2 bg-green-500 rounded hover:bg-green-400">Sign Up</a>
            </div>
            <button class="md:hidden" id="menu-toggle">
                <i data-feather="menu"></i>
            </button>
        </div>
        <!-- Mobile Menu -->
        <div class="md:hidden hidden bg-green-800 px-4 py-2" id="mobile-menu">
            <a href="#" class="block py-2 hover:bg-green-700 px-2 rounded">Home</a>
            <a href="#about" class="block py-2 hover:bg-green-700 px-2 rounded">About</a>
            <a href="#how-it-works" class="block py-2 hover:bg-green-700 px-2 rounded">How It Works</a>
            <a href="#contact" class="block py-2 hover:bg-green-700 px-2 rounded">Contact</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-bg text-white py-20">
        <div class="container mx-auto px-4 text-center" data-aos="fade-up">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">Farm Fresh Vegetables Direct to Your Door</h1>
            <p class="text-xl md:text-2xl mb-8 max-w-2xl mx-auto">Connecting farmers directly with consumers for fresher produce at better prices</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="signup.html" class="bg-green-500 hover:bg-green-600 text-white px-8 py-3 rounded-lg text-lg font-semibold transition duration-300">Get Started</a>
                <a href="#how-it-works" class="bg-white hover:bg-gray-100 text-green-700 px-8 py-3 rounded-lg text-lg font-semibold transition duration-300">Learn More</a>
            </div>
        </div>
    </section>

    <!-- Categories Preview -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">Our Categories</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Category 1 -->
                <div class="category-card bg-white rounded-lg shadow-md overflow-hidden transition duration-300" data-aos="fade-up">
                    <img src="http://static.photos/vegetables/640x360/1" alt="Leafy Vegetables" class="w-full h-48 object-cover">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-2 text-gray-800">Leafy Vegetables</h3>
                        <p class="text-gray-600">Fresh spinach, kale, lettuce and more</p>
                    </div>
                </div>
                
                <!-- Category 2 -->
                <div class="category-card bg-white rounded-lg shadow-md overflow-hidden transition duration-300" data-aos="fade-up" data-aos-delay="100">
                    <img src="http://static.photos/vegetables/640x360/2" alt="Root Vegetables" class="w-full h-48 object-cover">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-2 text-gray-800">Root Vegetables</h3>
                        <p class="text-gray-600">Carrots, potatoes, onions and more</p>
                    </div>
                </div>
                
                <!-- Category 3 -->
                <div class="category-card bg-white rounded-lg shadow-md overflow-hidden transition duration-300" data-aos="fade-up" data-aos-delay="200">
                    <img src="http://static.photos/vegetables/640x360/3" alt="Fruits" class="w-full h-48 object-cover">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-2 text-gray-800">Fruits</h3>
                        <p class="text-gray-600">Seasonal fruits from local orchards</p>
                    </div>
                </div>
                
                <!-- Category 4 -->
                <div class="category-card bg-white rounded-lg shadow-md overflow-hidden transition duration-300" data-aos="fade-up" data-aos-delay="300">
                    <img src="http://static.photos/grains/640x360/4" alt="Grains" class="w-full h-48 object-cover">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-2 text-gray-800">Grains</h3>
                        <p class="text-gray-600">Rice, wheat, millets and more</p>
                    </div>
                </div>
            </div>
            <div class="text-center mt-10">
                <a href="categories.html" class="inline-block px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition duration-300">
                    View All Categories
                </a>
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works" class="py-16 bg-gray-100">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">How Green Basket Works</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Step 1 -->
                <div class="bg-white p-6 rounded-lg shadow-md text-center" data-aos="fade-up">
                    <div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i data-feather="user" class="text-green-600"></i>
                    </div>
                    <h3 class="text-xl font-semibold mb-2">1. Create an Account</h3>
                    <p class="text-gray-600">Sign up as a farmer or customer to get started with our platform.</p>
                </div>
                
                <!-- Step 2 -->
                <div class="bg-white p-6 rounded-lg shadow-md text-center" data-aos="fade-up" data-aos-delay="100">
                    <div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i data-feather="shopping-cart" class="text-green-600"></i>
                    </div>
                    <h3 class="text-xl font-semibold mb-2">2. Browse or List Products</h3>
                    <p class="text-gray-600">Customers browse fresh produce, farmers list their harvests.</p>
                </div>
                
                <!-- Step 3 -->
                <div class="bg-white p-6 rounded-lg shadow-md text-center" data-aos="fade-up" data-aos-delay="200">
                    <div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i data-feather="truck" class="text-green-600"></i>
                    </div>
                    <h3 class="text-xl font-semibold mb-2">3. Get Fresh Delivery</h3>
                    <p class="text-gray-600">Farmers deliver directly to your doorstep or arrange for pickup.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row items-center">
                <div class="md:w-1/2 mb-8 md:mb-0 md:pr-8" data-aos="fade-right">
                    <img src="http://static.photos/farmers/640x360/5" alt="Farmers" class="rounded-lg shadow-lg w-full">
                </div>
                <div class="md:w-1/2" data-aos="fade-left">
                    <h2 class="text-3xl font-bold mb-6 text-gray-800">About Green Basket</h2>
                    <p class="text-gray-600 mb-4">
                        Green Basket is a revolutionary platform that connects local farmers directly with consumers, eliminating middlemen and ensuring fair prices for both parties.
                    </p>
                    <p class="text-gray-600 mb-4">
                        Our mission is to support local agriculture while providing consumers with the freshest, most affordable produce available.
                    </p>
                    <p class="text-gray-600">
                        By cutting out the traditional supply chain, we reduce costs, minimize food waste, and ensure farmers receive a larger share of the profits.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="py-16 bg-gray-100">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">What People Say</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Testimonial 1 -->
                <div class="bg-white p-6 rounded-lg shadow-md" data-aos="fade-up">
                    <div class="flex items-center mb-4">
                        <img src="http://static.photos/people/200x200/1" alt="Customer" class="w-12 h-12 rounded-full mr-4">
                        <div>
                            <h4 class="font-semibold">Sarah Johnson</h4>
                            <div class="flex text-yellow-400">
                                <i data-feather="star" class="fill-current"></i>
                                <i data-feather="star" class="fill-current"></i>
                                <i data-feather="star" class="fill-current"></i>
                                <i data-feather="star" class="fill-current"></i>
                                <i data-feather="star" class="fill-current"></i>
                            </div>
                        </div>
                    </div>
                    <p class="text-gray-600">
                        "The vegetables I get from Green Basket are so much fresher than the supermarket. I love knowing exactly which farm they come from!"
                    </p>
                </div>
                
                <!-- Testimonial 2 -->
                <div class="bg-white p-6 rounded-lg shadow-md" data-aos="fade-up" data-aos-delay="100">
                    <div class="flex items-center mb-4">
                        <img src="http://static.photos/people/200x200/2" alt="Farmer" class="w-12 h-12 rounded-full mr-4">
                        <div>
                            <h4 class="font-semibold">Raj Patel</h4>
                            <div class="flex text-yellow-400">
                                <i data-feather="star" class="fill-current"></i>
                                <i data-feather="star" class="fill-current"></i>
                                <i data-feather="star" class="fill-current"></i>
                                <i data-feather="star" class="fill-current"></i>
                                <i data-feather="star" class="fill-current"></i>
                            </div>
                        </div>
                    </div>
                    <p class="text-gray-600">
                        "Green Basket has transformed my farm business. I now get fair prices for my produce and have built relationships with local customers."
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-green-700 text-white">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-3xl font-bold mb-6">Ready to Experience Freshness?</h2>
            <p class="text-xl mb-8 max-w-2xl mx-auto">Join Green Basket today and start enjoying farm-fresh produce at affordable prices.</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="signup.html" class="bg-white hover:bg-gray-100 text-green-700 px-8 py-3 rounded-lg text-lg font-semibold transition duration-300">Sign Up Now</a>
                <a href="login.html" class="bg-green-600 hover:bg-green-500 text-white px-8 py-3 rounded-lg text-lg font-semibold transition duration-300">Login</a>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12 text-gray-800">Contact Us</h2>
            <div class="flex flex-col md:flex-row">
                <div class="md:w-1/2 mb-8 md:mb-0 md:pr-8">
                    <form class="space-y-4">
                        <div>
                            <label for="name" class="block text-gray-700 mb-2">Name</label>
                            <input type="text" id="name" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500">
                        </div>
                        <div>
                            <label for="email" class="block text-gray-700 mb-2">Email</label>
                            <input type="email" id="email" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500">
                        </div>
                        <div>
                            <label for="message" class="block text-gray-700 mb-2">Message</label>
                            <textarea id="message" rows="4" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"></textarea>
                        </div>
                        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold transition duration-300">Send Message</button>
                    </form>
                </div>
                <div class="md:w-1/2 md:pl-8">
                    <div class="bg-gray-100 p-6 rounded-lg h-full">
                        <h3 class="text-xl font-semibold mb-4 text-gray-800">Our Information</h3>
                        <div class="space-y-4">
                            <div class="flex items-start">
                                <i data-feather="map-pin" class="text-green-600 mr-4 mt-1"></i>
                                <p>123 Farm Road, Agricultural District, Country</p>
                            </div>
                            <div class="flex items-center">
                                <i data-feather="mail" class="text-green-600 mr-4"></i>
                                <p>contact@greenbasket.com</p>
                            </div>
                            <div class="flex items-center">
                                <i data-feather="phone" class="text-green-600 mr-4"></i>
                                <p>+1 (123) 456-7890</p>
                            </div>
                        </div>
                        <div class="mt-8">
                            <h4 class="text-lg font-semibold mb-3 text-gray-800">Follow Us</h4>
                            <div class="flex space-x-4">
                                <a href="#" class="bg-green-600 text-white p-2 rounded-full hover:bg-green-700">
                                    <i data-feather="facebook"></i>
                                </a>
                                <a href="#" class="bg-green-600 text-white p-2 rounded-full hover:bg-green-700">
                                    <i data-feather="twitter"></i>
                                </a>
                                <a href="#" class="bg-green-600 text-white p-2 rounded-full hover:bg-green-700">
                                    <i data-feather="instagram"></i>
                                </a>
                                <a href="#" class="bg-green-600 text-white p-2 rounded-full hover:bg-green-700">
                                    <i data-feather="linkedin"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-8">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <h3 class="text-xl font-bold mb-4">Green Basket</h3>
                    <p>Connecting farmers directly with consumers for fresher produce at better prices.</p>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Quick Links</h4>
                    <ul class="space-y-2">
                        <li><a href="#" class="hover:text-green-400">Home</a></li>
                        <li><a href="#about" class="hover:text-green-400">About</a></li>
                        <li><a href="#how-it-works" class="hover:text-green-400">How It Works</a></li>
                        <li><a href="#contact" class="hover:text-green-400">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Account</h4>
                    <ul class="space-y-2">
                        <li><a href="login.html" class="hover:text-green-400">Login</a></li>
                        <li><a href="signup.html" class="hover:text-green-400">Sign Up</a></li>
                        <li><a href="#" class="hover:text-green-400">Privacy Policy</a></li>
                        <li><a href="#" class="hover:text-green-400">Terms of Service</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Newsletter</h4>
                    <p>Subscribe to get updates on new products and offers.</p>
                    <div class="mt-4 flex">
                        <input type="email" placeholder="Your email" class="px-4 py-2 rounded-l-lg text-gray-800 w-full">
                        <button class="bg-green-600 hover:bg-green-500 px-4 py-2 rounded-r-lg">
                            <i data-feather="send"></i>
                        </button>
                    </div>
