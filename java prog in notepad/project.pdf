admin-dashboard.html

---------------------------------------------------------------------------------------------------------------------------

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farmer Dashboard - Green Basket</title>
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        .sidebar {
            transition: all 0.3s;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        .chart-container {
            height: 300px;
        }
        [data-aos] {
            transition: opacity 0.5s ease, transform 0.5s ease;
        }
    </style>
</head>
<body class="font-sans bg-gray-100">
    <!-- Dashboard Layout -->
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <div class="sidebar bg-green-800 text-white w-64 fixed h-full overflow-y-auto" id="sidebar">
            <div class="p-4 flex items-center space-x-3 border-b border-green-700">
                <div class="bg-green-600 p-2 rounded-full">
                    <i data-feather="shopping-bag" class="w-6 h-6"></i>
                </div>
                <h1 class="text-xl font-bold">Green Basket</h1>
            </div>
            
            <div class="p-4">
                <div class="flex items-center space-x-3 mb-6">
                    <img src="http://static.photos/people/200x200/42" alt="Profile" class="w-10 h-10 rounded-full object-cover">
                    <div>
                        <h3 class="font-medium">Farmer Name</h3>
                        <p class="text-green-200 text-sm">Admin</p>
                    </div>
                </div>
                
                <nav class="space-y-1">
                    <a href="#" class="flex items-center space-x-3 p-3 rounded-lg bg-green-700 text-white">
                        <i data-feather="home" class="w-5 h-5"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-green-700 text-green-100 hover:text-white">
                        <i data-feather="package" class="w-5 h-5"></i>
                        <span>Products</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-green-700 text-green-100 hover:text-white">
                        <i data-feather="shopping-cart" class="w-5 h-5"></i>
                        <span>Orders</span>
                        <span class="ml-auto bg-red-500 text-white text-xs px-2 py-1 rounded-full">5</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-green-700 text-green-100 hover:text-white">
                        <i data-feather="users" class="w-5 h-5"></i>
                        <span>Customers</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-green-700 text-green-100 hover:text-white">
                        <i data-feather="bar-chart-2" class="w-5 h-5"></i>
                        <span>Analytics</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-green-700 text-green-100 hover:text-white">
                        <i data-feather="message-square" class="w-5 h-5"></i>
                        <span>Feedback</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-green-700 text-green-100 hover:text-white">
                        <i data-feather="settings" class="w-5 h-5"></i>
                        <span>Settings</span>
                    </a>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 ml-64 overflow-auto">
            <!-- Top Navigation -->
            <header class="bg-white shadow-sm">
                <div class="flex items-center justify-between p-4">
                    <div class="flex items-center space-x-4">
                        <button id="sidebar-toggle" class="text-gray-600 hover:text-gray-900">
                            <i data-feather="menu" class="w-6 h-6"></i>
                        </button>
                        <div class="relative">
                            <input type="text" placeholder="Search..." class="pl-10 pr-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500">
                            <i data-feather="search" class="absolute left-3 top-2.5 text-gray-400"></i>
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        <button class="text-gray-600 hover:text-gray-900 relative">
                            <i data-feather="bell" class="w-6 h-6"></i>
                            <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center">3</span>
                        </button>
                        <div class="flex items-center space-x-2">
                            <img src="http://static.photos/people/200x200/42" alt="Profile" class="w-8 h-8 rounded-full object-cover">
                            <span class="font-medium">Farmer</span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <main class="p-6">
                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                    <div class="bg-white rounded-xl shadow-sm p-6" data-aos="fade-up">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500">Total Products</p>
                                <h3 class="text-2xl font-bold">142</h3>
                            </div>
                            <div class="bg-green-100 p-3 rounded-full">
                                <i data-feather="package" class="w-6 h-6 text-green-600"></i>
                            </div>
                        </div>
                        <p class="text-green-600 text-sm mt-2">+12% from last week</p>
                    </div>
                    
                    <div class="bg-white rounded-xl shadow-sm p-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500">Today's Orders</p>
                                <h3 class="text-2xl font-bold">24</h3>
                            </div>
                            <div class="bg-blue-100 p-3 rounded-full">
                                <i data-feather="shopping-cart" class="w-6 h-6 text-blue-600"></i>
                            </div>
                        </div>
                        <p class="text-blue-600 text-sm mt-2">+5% from yesterday</p>
                    </div>
                    
                    <div class="bg-white rounded-xl shadow-sm p-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500">Pending Orders</p>
                                <h3 class="text-2xl font-bold">8</h3>
                            </div>
                            <div class="bg-yellow-100 p-3 rounded-full">
                                <i data-feather="clock" class="w-6 h-6 text-yellow-600"></i>
                            </div>
                        </div>
                        <p class="text-yellow-600 text-sm mt-2">2 urgent deliveries</p>
                    </div>
                    
                    <div class="bg-white rounded-xl shadow-sm p-6" data-aos="fade-up" data-aos-delay="300">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-gray-500">Customer Rating</p>
                                <h3 class="text-2xl font-bold">4.8</h3>
                            </div>
                            <div class="bg-purple-100 p-3 rounded-full">
                                <i data-feather="star" class="w-6 h-6 text-purple-600"></i>
                            </div>
                        </div>
                        <p class="text-purple-600 text-sm mt-2">+0.2 from last month</p>
                    </div>
                </div>

                <!-- Charts and Recent Orders -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
                    <!-- Sales Chart -->
                    <div class="bg-white rounded-xl shadow-sm p-6 lg:col-span-2" data-aos="fade-up">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-lg font-semibold">Weekly Sales</h2>
                            <select class="border rounded-lg px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
                                <option>This Week</option>
                                <option>Last Week</option>
                                <option>This Month</option>
                            </select>
                        </div>
                        <div class="chart-container">
                            <canvas id="salesChart"></canvas>
                        </div>
                    </div>
                    
                    <!-- Recent Orders -->
                    <div class="bg-white rounded-xl shadow-sm p-6" data-aos="fade-up" data-aos-delay="100">
                        <h2 class="text-lg font-semibold mb-4">Recent Orders</h2>
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-3 border-b">
                                <div>
                                    <p class="font-medium">#ORD-4567</p>
                                    <p class="text-sm text-gray-500">Tomatoes, Potatoes</p>
                                </div>
                                <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full">Delivered</span>
                            </div>
                            <div class="flex items-center justify-between p-3 border-b">
                                <div>
                                    <p class="font-medium">#ORD-4566</p>
                                    <p class="text-sm text-gray-500">Apples, Oranges</p>
                                </div>
                                <span class="bg-yellow-100 text-yellow-800 text-xs px-2 py-1 rounded-full">Processing</span>
                            </div>
                            <div class="flex items-center justify-between p-3 border-b">
                                <div>
                                    <p class="font-medium">#ORD-4565</p>
                                    <p class="text-sm text-gray-500">Carrots, Onions</p>
                                </div>
                                <span class="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full">Shipped</span>
                            </div>
                            <div class="flex items-center justify-between p-3 border-b">
                                <div>
                                    <p class="font-medium">#ORD-4564</p>
                                    <p class="text-sm text-gray-500">Milk, Eggs</p>
                                </div>
                                <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full">Pending</span>
                            </div>
                        </div>
                        <a href="#" class="block text-center text-green-600 mt-4 text-sm font-medium">View All Orders</a>
                    </div>
                </div>

                <!-- Products and Quick Actions -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Top Products -->
                    <div class="bg-white rounded-xl shadow-sm p-6 lg:col-span-2" data-aos="fade-up">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-lg font-semibold">Top Products</h2>
                            <button class="text-green-600 text-sm font-medium">Manage Products</button>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead>
                                    <tr class="text-left text-gray-500 text-sm border-b">
                                        <th class="pb-2">Product</th>
                                        <th class="pb-2">Stock</th>
                                        <th class="pb-2">Price</th>
                                        <th class="pb-2">Sold</th>
                                        <th class="pb-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y">
                                    <tr>
                                        <td class="py-3 flex items-center space-x-3">
                                            <img src="http://static.photos/food/200x200/1" alt="Tomatoes" class="w-10 h-10 rounded object-cover">
                                            <span>Organic Tomatoes</span>
                                        </td>
                                        <td class="py-3">
                                            <div class="w-full bg-gray-200 rounded-full h-2">
                                                <div class="bg-green-600 h-2 rounded-full" style="width: 45%"></div>
                                            </div>
                                            <span class="text-xs text-gray-500">45/100 kg</span>
                                        </td>
                                        <td class="py-3">$2.99/kg</td>
                                        <td class="py-3">55 kg</td>
                                        <td class="py-3">
                                            <button class="text-green-600 hover:text-green-800">
                                                <i data-feather="edit" class="w-4 h-4"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="py-3 flex items-center space-x-3">
                                            <img src="http://static.photos/food/200x200/2" alt="Potatoes" class="w-10 h-10 rounded object-cover">
                                            <span>Fresh Potatoes</span>
                                        </td>
                                        <td class="py-3">
                                            <div class="w-full bg-gray-200 rounded-full h-2">
                                                <div class="bg-green-600 h-2 rounded-full" style="width: 70%"></div>
                                            </div>
                                            <span class="text-xs text-gray-500">70/100 kg</span>
                                        </td>
                                        <td class="py-3">$1.49/kg</td>
                                        <td class="py-3">30 kg</td>
                                        <td class="py-3">
                                            <button class="text-green-600 hover:text-green-800">
                                                <i data-feather="edit" class="w-4 h-4"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="py-3 flex items-center space-x-3">
                                            <img src="http://static.photos/food/200x200/3" alt="Apples" class="w-10 h-10 rounded object-cover">
                                            <span>Red Apples</span>
                                        </td>
                                        <td class="py-3">
                                            <div class="w-full bg-gray-200 rounded-full h-2">
                                                <div class="bg-green-600 h-2 rounded-full" style="width: 30%"></div>
                                            </div>
                                            <span class="text-xs text-gray-500">30/100 kg</span>
                                        </td>
                                        <td class="py-3">$3.99/kg</td>
                                        <td class="py-3">70 kg</td>
                                        <td class="py-3">
                                            <button class="text-green-600 hover:text-green-800">
                                                <i data-feather="edit" class="w-4 h-4"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Quick Actions -->
                    <div class="bg-white rounded-xl shadow-sm p-6" data-aos="fade-up" data-aos-delay="100">
                        <h2 class="text-lg font-semibold mb-4">Quick Actions</h2>
                        <div class="space-y-3">
                            <button class="w-full flex items-center space-x-3 p-3 rounded-lg bg-green-600 text-white hover:bg-green-700 transition">
                                <i data-feather="plus" class="w-5 h-5"></i>
                                <span>Add New Product</span>
                            </button>
                            <button class="w-full flex items-center space-x-3 p-3 rounded-lg border border-green-600 text-green-600 hover:bg-green-50 transition">
                                <i data-feather="refresh-cw" class="w-5 h-5"></i>
                                <span>Update Stock</span>
                            </button>
                            <button class="w-full flex items-center space-x-3 p-3 rounded-lg border border-blue-600 text-blue-600 hover:bg-blue-50 transition">
                                <i data-feather="truck" class="w-5 h-5"></i>
                                <span>Process Orders</span>
                            </button>
                            <button class="w-full flex items-center space-x-3 p-3 rounded-lg border border-red-600 text-red-600 hover:bg-red-50 transition">
                                <i data-feather="trash-2" class="w-5 h-5"></i>
                                <span>Record Waste</span>
                            </button>
                        </div>
                        
                        <div class="mt-6">
                            <h3 class="font-medium mb-2">Stock Alert</h3>
                            <div class="space-y-2">
                                <div class="flex items-center justify-between p-2 bg-red-50 rounded">
                                    <span class="text-sm">Organic Tomatoes</span>
                                    <span class="text-xs bg-red-100 text-red-800 px-2 py-1 rounded-full">Low</span>
                                </div>
                                <div class="flex items-center justify-between p-2 bg-red-50 rounded">
                                    <span class="text-sm">Red Apples</span>
                                    <span class="text-xs bg-red-100 text-red-800 px-2 py-1 rounded-full">Low</span>
                                </div>
                                <div class="flex items-center justify-between p-2 bg-yellow-50 rounded">
                                    <span class="text-sm">Fresh Potatoes</span>
                                    <span class="text-xs bg-yellow-100 text-yellow-800 px-2 py-1 rounded-full">Medium</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Initialize AOS
        AOS.init();
        
        // Initialize Feather Icons
        feather.replace();
        
        // Toggle Sidebar
        document.getElementById('sidebar-toggle').addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('-translate-x-full');
        });
        
        // Sales Chart
        const salesCtx = document.getElementById('salesChart').getContext('2d');
        const salesChart = new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{
                    label: 'Sales',
                    data: [12, 19, 15, 23, 18, 25, 22],
                    backgroundColor: 'rgba(5, 150, 105, 0.1)',
                    borderColor: 'rgba(5, 150, 105, 1)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
</body>
</html> 

