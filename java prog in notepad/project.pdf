<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Green Basket</title>
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        .login-bg {
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('http://static.photos/farm/1200x630/10');
            background-size: cover;
            background-position: center;
        }
    </style>
</head>
<body class="font-sans bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-green-700 text-white shadow-lg">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i data-feather="shopping-bag" class="text-green-300"></i>
                <span class="text-xl font-bold">Green Basket</span>
            </div>
            <div class="hidden md:flex space-x-6">
                <a href="index.html" class="hover:text-green-200">Home</a>
                <a href="index.html#about" class="hover:text-green-200">About</a>
                <a href="index.html#how-it-works" class="hover:text-green-200">How It Works</a>
                <a href="index.html#contact" class="hover:text-green-200">Contact</a>
            </div>
            <div class="flex space-x-4">
                <a href="login.html" class="px-4 py-2 bg-green-600 rounded">Login</a>
                <a href="signup.html" class="px-4 py-2 bg-green-500 rounded hover:bg-green-400">Sign Up</a>
            </div>
            <button class="md:hidden" id="menu-toggle">
                <i data-feather="menu"></i>
            </button>
        </div>
        <!-- Mobile Menu -->
        <div class="md:hidden hidden bg-green-800 px-4 py-2" id="mobile-menu">
            <a href="index.html" class="block py-2 hover:bg-green-700 px-2 rounded">Home</a>
            <a href="index.html#about" class="block py-2 hover:bg-green-700 px-2 rounded">About</a>
            <a href="index.html#how-it-works" class="block py-2 hover:bg-green-700 px-2 rounded">How It Works</a>
            <a href="index.html#contact" class="block py-2 hover:bg-green-700 px-2 rounded">Contact</a>
        </div>
    </nav>

    <!-- Login Section -->
    <section class="login-bg text-white py-20">
        <div class="container mx-auto px-4">
            <div class="max-w-md mx-auto bg-white bg-opacity-90 backdrop-blur-sm rounded-lg overflow-hidden shadow-lg" data-aos="fade-up">
                <div class="bg-green-700 px-6 py-4">
                    <h2 class="text-2xl font-bold text-center">Login to Green Basket</h2>
                </div>
                <div class="p-6 text-gray-800">
                    <div class="flex justify-center mb-6">
                        <button id="user-btn" class="px-6 py-2 bg-green-600 text-white rounded-l-lg font-medium">User</button>
                        <button id="admin-btn" class="px-6 py-2 bg-gray-200 text-gray-800 rounded-r-lg font-medium">Farmer</button>
                    </div>
                    
                    <!-- User Login Form -->
                    <form id="user-form" class="space-y-4">
                        <div>
                            <label for="user-email" class="block mb-2 font-medium">Email</label>
                            <input type="email" id="user-email" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500" required>
                        </div>
                        <div>
                            <label for="user-password" class="block mb-2 font-medium">Password</label>
                            <input type="password" id="user-password" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500" required>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <input type="checkbox" id="remember" class="h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300 rounded">
                                <label for="remember" class="ml-2 block text-sm text-gray-700">Remember me</label>
                            </div>
                            <a href="forgot-password.html" class="text-sm text-green-600 hover:underline">Forgot password?</a>
                        </div>
                        <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg font-semibold transition duration-300">Login</button>
                    </form>
                    
                    <!-- Admin Login Form (Hidden by default) -->
                    <form id="admin-form" class="space-y-4 hidden">
                        <div>
                            <label for="admin-email" class="block mb-2 font-medium">Email</label>
                            <input type="email" id="admin-email" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500" required>
                        </div>
                        <div>
                            <label for="admin-password" class="block mb-2 font-medium">Password</label>
                            <input type="password" id="admin-password" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500" required>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <input type="checkbox" id="remember-admin" class="h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300 rounded">
                                <label for="remember-admin" class="ml-2 block text-sm text-gray-700">Remember me</label>
                            </div>
                            <a href="forgot-password.html" class="text-sm text-green-600 hover:underline">Forgot password?</a>
                        </div>
                        <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg font-semibold transition duration-300">Login as Farmer</button>
                    </form>
                    
                    <div class="mt-4 text-center">
                        <p class="text-gray-600">Don't have an account? <a href="signup.html" class="text-green-600 hover:underline">Sign up</a></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-8">
        <div class="container mx-auto px-4 text-center">
            <p>&copy; 2023 Green Basket. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        document.getElementById('menu-toggle').addEventListener('click', function() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        });

        // Toggle between user and admin login forms
        const userBtn = document.getElementById('user-btn');
        const adminBtn = document.getElementById('admin-btn');
        const userForm = document.getElementById('user-form');
        const adminForm = document.getElementById('admin-form');

        userBtn.addEventListener('click', function(e) {
            e.preventDefault();
            userBtn.classList.remove('bg-gray-200', 'text-gray-800');
            userBtn.classList.add('bg-green-600', 'text-white');
            adminBtn.classList.remove('bg-green-600', 'text-white');
            adminBtn.classList.add('bg-gray-200', 'text-gray-800');
            userForm.classList.remove('hidden');
            adminForm.classList.add('hidden');
        });

        adminBtn.addEventListener('click', function(e) {
            e.preventDefault();
            adminBtn.classList.remove('bg-gray-200', 'text-gray-800');
            adminBtn.classList.add('bg-green-600', 'text-white');
            userBtn.classList.remove('bg-green-600', 'text-white');
            userBtn.classList.add('bg-gray-200', 'text-gray-800');
            adminForm.classList.remove('hidden');
            userForm.classList.add('hidden');
        });

        // Form submission
        userForm.addEventListener('submit', function(e) {
            e.preventDefault();
            // Here you would typically validate and send the data to your backend
            window.location.href = 'user-dashboard.html';
        });

        adminForm.addEventListener('submit', function(e) {
            e.preventDefault();
            // Here you would typically validate and send the data to your backend
            window.location.href = 'admin-dashboard.html';
        });

        // Initialize AOS and Feather Icons
        AOS.init();
        feather.replace();
    </script>
</body>
</html>

