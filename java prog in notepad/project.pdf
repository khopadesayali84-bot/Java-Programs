                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-sm text-gray-600">Organic, Sustainable</span>
                                    <a href="#" class="text-green-600 hover:underline text-sm">View Products</a>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Farmer 3 -->
                        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
                            <img src="http://static.photos/farmers/640x360/12" alt="Sunny Orchard" class="w-full h-40 object-cover">
                            <div class="p-4">
                                <h3 class="font-semibold text-lg mb-1">Sunny Orchard</h3>
                                <div class="flex items-center text-sm text-gray-600 mb-2">
                                    <i data-feather="map-pin" class="w-4 h-4 mr-1"></i>
                                    <span>5.1 km away</span>
                                </div>
                                <div class="flex items-center mb-3">
                                    <div class="flex text-yellow-400">
                                        <i data-feather="star" class="fill-current w-4 h-4"></i>
                                        <i data-feather="star" class="fill-current w-4 h-4"></i>
                                        <i data-feather="star" class="fill-current w-4 h-4"></i>
                                        <i data-feather="star" class="fill-current w-4 h-4"></i>
                                        <i data-feather="star" class="w-4 h-4 text-gray-300"></i>
                                    </div>
                                    <span class="text-gray-500 text-xs ml-1">(38 reviews)</span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-sm text-gray-600">Fruits, Organic</span>
                                    <a href="#" class="text-green-600 hover:underline text-sm">View Products</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        // Toggle sidebar on mobile
        document.getElementById('sidebar-toggle').addEventListener('click', function() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('-ml-64');
        });

        // Initialize AOS and Feather Icons
        AOS.init();
        feather.replace();
    </script>
</body>
</html>

