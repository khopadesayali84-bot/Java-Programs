                            <div class="p-4">
                                <h3 class="font-semibold text-lg mb-1">Fresh Apples</h3>
                                <p class="text-gray-600 text-sm mb-2">From Sunny Orchard</p>
                                <div class="flex items-center mb-2">
                                    <div class="flex text-yellow-400">
                                        <i data-feather="star" class="fill-current w-4 h-4"></i>
                                        <i data-feather="star" class="fill-current w-4 h-4"></i>
                                        <i data-feather="star" class="fill-current w-4 h-4"></i>
                                        <i data-feather="star" class="fill-current w-4 h-4"></i>
